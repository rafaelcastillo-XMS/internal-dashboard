# Supabase — copy this file to .env and fill in your values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Notion client sync — server-side only; never prefix these with VITE_
NOTION_API_KEY=ntn_your_integration_token_here
NOTION_DATA_SOURCE_ID=your_clients_data_source_id_here

# Anthropic — Claude AI (Ask AI Anything modal)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ahrefs — server-side only; never prefix this variable with VITE_
AHREFS_API_KEY=your_ahrefs_api_key_here

# Meta Graph API — Social module (Facebook Page).
# Server-side only; never prefix these with VITE_.
# META_ACCESS_TOKEN is a Business Manager System User token generated with
# "Token Expiration: Never" and the pages_show_list + pages_read_engagement
# scopes. Reach, impressions and like/comment counts additionally require
# read_insights and pages_read_user_content, which are pending App Review.
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_system_user_token_here
META_PAGE_ID=your_facebook_page_id_here

# GitHub — optional, required when XMS-Ai/company-skills is private
GITHUB_TOKEN=your_github_token_here
COMPANY_SKILLS_REPO=XMS-Ai/company-skills
COMPANY_SKILLS_BRANCH=main

# Local server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
INTERNAL_API_SECRET=replace_with_a_long_random_value

# Google OAuth and reporting
GOOGLE_REQUIRED_EMAIL=
GBP_REQUIRED_EMAIL=xperiencemarketingsolutions@gmail.com
ADS_DEVELOPER_TOKEN=
ADS_MCC_ID=
PSI_API_KEY=

# Monday.com
MONDAY_API_TOKEN=
# JSON object mapping dashboard emails to Monday user IDs
MONDAY_EMAIL_MAP={}

# n8n callbacks and workflows
N8N_CALLBACK_SECRET=
N8N_ONPAGE_AUDIT_WEBHOOK=

# Optional NotebookLM bridge
NOTEBOOKLM_PYTHON_BIN=
